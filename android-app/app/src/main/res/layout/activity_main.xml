<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/rootScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_dark">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <!--  HEADER  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/profileIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good Afternoon"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="18sp"
                        android:layout_marginTop="2dp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/btnThemeToggle"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/button_secondary"
                android:gravity="center"
                android:text="☾"
                android:textColor="@color/text_primary_dark"
                android:textSize="22sp"/>
        </LinearLayout>


        <!--  START CARD  -->
        <LinearLayout
            android:id="@+id/startCard"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/card_dark">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvStartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Join to communicate"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvStartSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start using SilentVoice modes"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:id="@+id/btnStartNow"
                    android:layout_width="100dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Start Now"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_primary"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/imgPeople"
                android:layout_width="110dp"
                android:layout_height="95dp"
                android:src="@drawable/people_light"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <!--  SYSTEM MODE CARD  -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_dark"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:id="@+id/tvStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Mode"
                android:textColor="@color/text_secondary_dark"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvCurrentMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Manual Control"
                android:textColor="@color/accent"
                android:textSize="24sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Manual sliders active — no hardware required"
                android:textColor="@color/text_secondary_dark"
                android:textSize="13sp"/>
            <LinearLayout
                android:id="@+id/modesContainer"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/modeHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_primary"
                    android:gravity="center"
                    android:text="Default"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/modeEmergency"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_secondary"
                    android:gravity="center"
                    android:text="Emergency"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/modeHealth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/button_secondary"
                    android:gravity="center"
                    android:text="Health"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnManualMode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_primary"
                    android:gravity="center"
                    android:text="Manual"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/btnSimulationMode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_secondary"
                    android:gravity="center"
                    android:text="Simulation"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
        <!--  RESULT CARD  -->
        <LinearLayout android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_dark"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">
            <TextView
                android:id="@+id/tvResultLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DETECTED INTENT"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvDetectedWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Unknown"
                android:textColor="@color/accent"
                android:textSize="44sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvDetectedMeaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No saved gesture matched this pattern"
                android:textColor="@color/text_primary_dark"
                android:textSize="16sp"/>
            <ImageView
                android:id="@+id/btnSpeak"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_speaker"
                android:clickable="true"
                android:focusable="true"/>
            <LinearLayout
                android:id="@+id/suggestionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/button_secondary"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvSuggestion1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="• Suggestions will appear here"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="13sp"
                    android:padding="14dp"
                    android:backgroundTint="@android:color/transparent" />

                <TextView
                    android:id="@+id/tvSuggestion2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text=""
                    android:textColor="?android:textColorPrimary"
                    android:textSize="13sp"
                    android:padding="14dp"
                    android:backgroundTint="@android:color/transparent" />

                <TextView
                    android:id="@+id/tvSuggestion3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="?android:textColorPrimary"
                    android:textSize="13sp"
                    android:padding="14dp"
                    android:backgroundTint="@android:color/transparent" />
            </LinearLayout>
            <Button
                android:id="@+id/btnRefreshSuggestions"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_primary"
                android:text="Refresh Suggestions"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/spinnerLanguage"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:padding="10dp" />

            <Button
                android:id="@+id/btnTranslateSuggestion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_primary"
                android:text="Translate Suggestion"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTranslatedSuggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:text=""
                android:textSize="15sp" />
        </LinearLayout>
        <!--  FINGER STATES CARD  -->
        <LinearLayout
            android:id="@+id/fingerStatesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_dark"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:id="@+id/tvFingerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finger States"
                android:textColor="@color/text_primary_dark"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvPattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pattern: -"
                android:textColor="@color/text_secondary_dark"
                android:textSize="13sp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/cardThumb"
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_secondary"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvThumbLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thumb"
                        android:textColor="@color/text_secondary_dark"/>
                    <TextView
                        android:id="@+id/tvThumbState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/thumb"
                        android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardIndex"
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_secondary"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvIndexLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Index"
                        android:textColor="@color/text_secondary_dark"/>
                    <TextView
                        android:id="@+id/tvIndexState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/index"
                        android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardMiddle"
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_secondary"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvMiddleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Middle"
                        android:textColor="@color/text_secondary_dark"/>
                    <TextView
                        android:id="@+id/tvMiddleState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/middle"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/cardRing"
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_secondary"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvRingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ring"
                        android:textColor="@color/text_secondary_dark"/>
                    <TextView
                        android:id="@+id/tvRingState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/ring"
                        android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cardPinky"
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_secondary"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvPinkyLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pinky"
                        android:textColor="@color/text_secondary_dark"/>
                    <TextView
                        android:id="@+id/tvPinkyState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/pinky"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <!--  HAND ANIMATION CARD  -->
        <LinearLayout
            android:id="@+id/handAnimationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_dark"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:id="@+id/tvHandAnimationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Hand Animation"
                android:textColor="@color/text_primary_dark"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvHandAnimationSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="The hand moves with the current flex sensor values." android:textColor="@color/text_secondary_dark" android:textSize="13sp"/>
            <com.example.silentvoice.HandAnimationView
                android:id="@+id/handAnimationView"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_secondary"/>
        </LinearLayout>
        <!--  MANUAL PANEL  -->
        <LinearLayout
            android:id="@+id/manualPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_dark"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Manual IMU Control"
                android:textColor="@color/text_primary_dark"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvManualAccX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acc X: 0"
                android:textColor="@color/text_primary_dark"/>
            <SeekBar
                android:id="@+id/seekAccX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
               />
            <TextView
                android:id="@+id/tvManualAccY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acc Y: 0"
                android:textColor="@color/text_primary_dark"/>
            <SeekBar
                android:id="@+id/seekAccY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                />
            />
            <TextView
                android:id="@+id/tvManualAccZ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acc Z: 0"
                android:textColor="@color/text_primary_dark"/>
            <SeekBar
                android:id="@+id/seekAccZ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"/>
            <TextView
                android:id="@+id/tvManualGyroX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gyro X: 0"
                android:textColor="@color/text_primary_dark"/>
            <SeekBar
                android:id="@+id/seekGyroX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"/>
            <TextView
                android:id="@+id/tvManualGyroY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gyro Y: 0"
                android:textColor="@color/text_primary_dark"/>
            <SeekBar
                android:id="@+id/seekGyroY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"/>
            <TextView
                android:id="@+id/tvManualGyroZ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gyro Z: 0"
                android:textColor="@color/text_primary_dark"/>
            <SeekBar android:id="@+id/seekGyroZ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"/>
            <TextView
                android:id="@+id/tvManualTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual Finger Control"
                android:textColor="@color/text_primary_dark"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvManualSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use sliders to simulate glove finger bending."
                android:textColor="@color/text_secondary_dark"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvThumbValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Thumb: 0%"
                android:textColor="@color/text_primary_dark"
                android:textStyle="bold"/>
            <SeekBar
                android:id="@+id/seekThumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/thumb"
                android:thumbTint="@color/thumb"/>
            <TextView
                android:id="@+id/tvIndexValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Index: 80%"
                android:textColor="@color/text_primary_dark"
                android:textStyle="bold"/>
            <SeekBar
                android:id="@+id/seekIndex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" android:progress="80"
                android:progressTint="@color/index"
                android:thumbTint="@color/index"/>
            <TextView
                android:id="@+id/tvMiddleValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Middle: 0%"
                android:textColor="@color/text_primary_dark"
                android:textStyle="bold"/>
            <SeekBar
                android:id="@+id/seekMiddle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/middle"
                android:thumbTint="@color/middle"/>
            <TextView
                android:id="@+id/tvRingValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ring: 0%"
                android:textColor="@color/text_primary_dark"
                android:textStyle="bold"/>
            <SeekBar android:id="@+id/seekRing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/ring"
                android:thumbTint="@color/ring"/>
            <TextView
                android:id="@+id/tvPinkyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pinky: 80%"
                android:textColor="@color/text_primary_dark"
                android:textStyle="bold"/>
            <SeekBar
                android:id="@+id/seekPinky"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" android:progress="80"
                android:progressTint="@color/pinky"
                android:thumbTint="@color/pinky"/>
        </LinearLayout>
        <!--  SIMULATION PANEL  -->
        <LinearLayout
            android:id="@+id/simulationPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_dark"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvSimulationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wokwi Simulation Stream"
                android:textColor="@color/text_primary_dark"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvSimulationSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Live data from Wokwi extension / VS Code will appear here." android:textColor="@color/text_secondary_dark" android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvLiveJson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="monospace"
                android:padding="14dp"
                android:text="Waiting for Wokwi data..."
                android:textColor="@color/text_primary_dark"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvImuTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="IMU Live Values"
                android:textColor="@color/text_primary_dark"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvAccValues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_secondary"
                android:padding="12dp"
                android:text="ACC: X=0, Y=0, Z=0"
                android:textColor="#000000"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvGyroValues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_secondary"
                android:padding="12dp"
                android:text="GYRO: X=0, Y=0, Z=0"
                android:textColor="#000000"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvHandOrientation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_secondary"
                android:padding="12dp"
                android:text="Hand Orientation: -"
                android:textColor="#000000"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvChartTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Live Sensor Chart"
                android:textColor="@color/text_primary_dark"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/liveLineChart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:padding="8dp"/>
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/imuLineChart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:padding="8dp"/>

        </LinearLayout>
        <Button
            android:id="@+id/btnSOS"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_sos"
            android:text="SOS Emergency"
            android:textAllCaps="false"
            android:textColor="@color/text_primary_dark"
            android:textSize="17sp"
            android:textStyle="bold"/>
        <!--  CUSTOM CARD  -->
        <LinearLayout
            android:id="@+id/customCard"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_dark"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:id="@+id/tvCustomTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Gesture Mapping"
                android:textColor="@color/text_primary_dark"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvCurrentPattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Current pattern: -"
                android:textColor="@color/text_secondary_dark"
                android:textSize="13sp"/>
            <EditText
                android:id="@+id/etCustomWord"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_secondary"
                android:hint="Enter word e.g. Water"
                android:padding="12dp"
                android:textColor="@color/text_primary_dark"
                android:textColorHint="@color/text_secondary_dark"/>
            <Button
                android:id="@+id/btnSaveGesture"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_primary"
                android:text="Save Gesture"
                android:textAllCaps="false"
                android:textColor="@color/text_primary_dark"
                android:textStyle="bold"/>
        </LinearLayout>
        <!--  HISTORY CARD  -->
        <LinearLayout
            android:id="@+id/historyCard"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_dark"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:id="@+id/tvHistoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detection History"
                android:textColor="@color/text_primary_dark"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>