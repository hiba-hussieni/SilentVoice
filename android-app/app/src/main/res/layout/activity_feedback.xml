<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feedbackRootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:id="@+id/feedbackRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="90dp">

            <!-- THEME TOGGLE -->

            <TextView
                android:id="@+id/btnThemeFeedback"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="end"
                android:gravity="center"
                android:text="☾"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_theme_toggle_light" />

            <!-- CENTER CONTENT -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtQuestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="How was your experience\nwith us?"
                    android:textColor="#444444"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/txtFace"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_marginTop="35dp"
                    android:gravity="center"
                    android:text="😊"
                    android:textColor="#14A7A4"
                    android:textSize="115sp" />

                <TextView
                    android:id="@+id/txtMood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="GOOD"
                    android:textColor="#14A7A4"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <!-- MOOD BUTTONS -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="45dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBad"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FF6B6B"
                        android:text="BAD"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnUgh"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FFD966"
                        android:text="UGH"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnOk"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        android:backgroundTint="#11C5D9"
                        android:text="OK"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnGood"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        android:backgroundTint="#14A7A4"
                        android:text="GOOD"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- SUBMIT -->

                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="180dp"
                    android:layout_height="55dp"
                    android:layout_marginTop="35dp"
                    android:backgroundTint="#14A7A4"
                    android:text="SUBMIT"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BACK BUTTON -->

    <TextView
        android:id="@+id/btnBackFeedback"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_theme_toggle_light"
        android:gravity="center"
        android:text="←"
        android:textColor="#111827"
        android:textSize="30sp"
        android:textStyle="bold" />

</FrameLayout>