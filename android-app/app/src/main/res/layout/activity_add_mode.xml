
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/rootScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark"
        android:paddingBottom="80dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <!--  HEADER  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/profileCircle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_circle"
                        android:gravity="center"
                        android:text="👤"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Good Afternoon"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Guest"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/btnThemeToggle"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/button_secondary"
                    android:gravity="center" android:text="☾"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="22sp"/>
            </LinearLayout>
            <!--  ADD MODE CARD  -->
            <LinearLayout
                android:id="@+id/startCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_dark"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:id="@+id/tvStartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Mode"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvStartSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Create a mode and word for this gesture"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="13sp"/>
                <EditText
                    android:id="@+id/etModeName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/button_secondary"
                    android:hint="Write mode name"
                    android:padding="12dp"
                    android:textColor="@color/text_primary_dark"
                    android:textColorHint="@color/text_secondary_dark"/>
                <EditText
                    android:id="@+id/etModeWord"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_secondary"
                    android:hint="Write word"
                    android:padding="12dp"
                    android:textColor="@color/text_primary_dark"
                    android:textColorHint="@color/text_secondary_dark"/>
                <Button
                    android:id="@+id/btnAddMode"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_primary"
                    android:text="Add Mode"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"/>
            </LinearLayout>
            <!--  SYSTEM MODE CARD  -->
            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_dark"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:id="@+id/tvStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System Mode"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvCurrentMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Manual Control"
                    android:textColor="@color/accent"
                    android:textSize="24sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Manual sliders active — no hardware required"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="13sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/btnManualMode"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_primary"
                        android:gravity="center"
                        android:text="Manual"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/btnSimulationMode"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_secondary"
                        android:gravity="center"
                        android:text="Simulation"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
            <!--  FINGER STATES CARD  -->
            <LinearLayout
                android:id="@+id/fingerStatesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_dark"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:id="@+id/tvFingerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finger States"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvPattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pattern: -"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="13sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:id="@+id/cardThumb"
                        android:layout_width="0dp"
                        android:layout_height="86dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_secondary"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvThumbLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thumb"
                            android:textColor="@color/text_secondary_dark"/>
                        <TextView
                            android:id="@+id/tvThumbState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="@color/thumb"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/cardIndex"
                        android:layout_width="0dp"
                        android:layout_height="86dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_secondary"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvIndexLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Index"
                            android:textColor="@color/text_secondary_dark"/>
                        <TextView
                            android:id="@+id/tvIndexState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="@color/index"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/cardMiddle"
                        android:layout_width="0dp"
                        android:layout_height="86dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_secondary"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvMiddleLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Middle"
                            android:textColor="@color/text_secondary_dark"/>
                        <TextView android:id="@+id/tvMiddleState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="@color/middle"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:id="@+id/cardRing"
                        android:layout_width="0dp"
                        android:layout_height="86dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_secondary"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvRingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ring"
                            android:textColor="@color/text_secondary_dark"/>
                        <TextView
                            android:id="@+id/tvRingState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="@color/ring"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/cardPinky"
                        android:layout_width="0dp"
                        android:layout_height="86dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_secondary"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvPinkyLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pinky"
                            android:textColor="@color/text_secondary_dark"/>
                        <TextView
                            android:id="@+id/tvPinkyState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="@color/pinky"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <!--  GESTURE PREVIEW CARD  -->
            <LinearLayout
                android:id="@+id/gesturePreviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_dark"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:id="@+id/tvGesturePreviewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gesture Preview"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvGesturePreviewSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Preview the full hand before saving the gesture."
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="13sp"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp">
                    <com.example.silentvoice.HandAnimationView
                        android:id="@+id/handAnimationView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"/>
                </FrameLayout>
            </LinearLayout>
            <!--  MANUAL PANEL  -->
            <LinearLayout
                android:id="@+id/manualPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_dark"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manual IMU Control"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvAccXValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Acc X: 0"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <SeekBar
                    android:id="@+id/seekAccX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"/>
                <TextView
                    android:id="@+id/tvAccYValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acc Y: 0"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <SeekBar
                    android:id="@+id/seekAccY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"/>
                <TextView
                    android:id="@+id/tvAccZValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acc Z: 0"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <SeekBar
                    android:id="@+id/seekAccZ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"/>
                <TextView
                    android:id="@+id/tvGyroXValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gyro X: 0"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <SeekBar android:id="@+id/seekGyroX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"/>
                <TextView
                    android:id="@+id/tvGyroYValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gyro Y: 0"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <SeekBar
                    android:id="@+id/seekGyroY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"/>
                <TextView
                    android:id="@+id/tvGyroZValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gyro Z: 0"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <SeekBar
                    android:id="@+id/seekGyroZ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"/>
                <TextView
                    android:id="@+id/tvManualTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Manual Finger Control"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvManualSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use sliders to simulate glove finger bending."
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="13sp"/>
                <TextView

                    android:id="@+id/tvThumbValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Thumb: 0%"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <SeekBar
                    android:id="@+id/seekThumb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100" android:progress="0"
                    android:progressTint="@color/thumb"
                    android:thumbTint="@color/thumb"/>
                <TextView
                    android:id="@+id/tvIndexValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Index: 80%"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <SeekBar
                    android:id="@+id/seekIndex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="80"
                    android:progressTint="@color/index"
                    android:thumbTint="@color/index"/>
                <TextView
                    android:id="@+id/tvMiddleValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Middle: 0%"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <SeekBar
                    android:id="@+id/seekMiddle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/middle"
                    android:thumbTint="@color/middle"/>
                <TextView
                    android:id="@+id/tvRingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ring: 0%"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <SeekBar
                    android:id="@+id/seekRing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/ring"
                    android:thumbTint="@color/ring"/>
                <TextView
                    android:id="@+id/tvPinkyValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pinky: 80%"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"/>
                <SeekBar
                    android:id="@+id/seekPinky"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="80"
                    android:progressTint="@color/pinky"
                    android:thumbTint="@color/pinky"/>
            </LinearLayout>
            <!--  SIMULATION PANEL  -->
            <LinearLayout
                android:id="@+id/simulationPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_dark"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wokwi Simulation Stream"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Live data from Wokwi extension / VS Code will appear here."
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:id="@+id/tvLiveJsonAdd"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/button_secondary"
                    android:padding="12dp"
                    android:text="Waiting for Wokwi data..."
                    android:textColor="@color/text_primary_dark"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="IMU Live Values"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvAccValuesAdd"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_secondary"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:text="ACC: X=0 Y=0 Z=0"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvGyroValuesAdd"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_secondary"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:text="GYRO: X=0 Y=0 Z=0"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvHandOrientationAdd"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_secondary"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:text="Hand Orientation: FLAT"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="13sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
    <TextView
        android:id="@+id/btnBackAdd"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="←"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/theme_circle_bg"/>
</FrameLayout>